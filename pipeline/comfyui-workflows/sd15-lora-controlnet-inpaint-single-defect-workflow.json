{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sd-v1-5-pruned-emaonly.safetensors"
    }
  },
  "2": {
    "class_type": "LoraLoader",
    "inputs": {
      "lora_name": "xray_crack_lora_r32.safetensors",
      "strength_model": 0.7,
      "strength_clip": 0.7,
      "model": ["1", 0],
      "clip": ["1", 1]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "xray_crack, weld crack defect, radiographic image, dark crack line, linear discontinuity",
      "clip": ["2", 1]
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "color, photograph, blurry, text, watermark, low quality, rgb, bright defect, white line",
      "clip": ["2", 1]
    }
  },
  "5": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "clean_background_512x512.png"
    }
  },
  "6": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "binary_mask_512x512.png"
    }
  },
  "7": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": ["5", 0],
      "vae": ["1", 2]
    }
  },
  "8": {
    "class_type": "SetLatentNoiseMask",
    "inputs": {
      "samples": ["7", 0],
      "mask": ["6", 1]
    }
  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 42,
      "steps": 20,
      "cfg": 10.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 0.7,
      "model": ["2", 0],
      "positive": ["3", 0],
      "negative": ["4", 0],
      "latent_image": ["8", 0]
    }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["10", 0],
      "vae": ["1", 2]
    }
  },
  "12": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "defect_inpaint_output",
      "images": ["11", 0]
    }
  }
}
