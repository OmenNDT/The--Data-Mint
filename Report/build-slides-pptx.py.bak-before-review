def drop_slides(prs, indexes):
    """Xoa cac slide theo chi so, giu nguyen quan he tep khac."""
    id_list = prs.slides._sldIdLst
    entries = list(id_list)
    for i in sorted(indexes, reverse=True):
        rid = entries[i].rId
        prs.part.drop_rel(rid)
        id_list.remove(entries[i])


def renumber_slide_parts(prs):
    """Danh so lai partname cac slide con giu, tranh trung ten khi them slide moi."""
    for i, slide in enumerate(prs.slides, start=1):
        slide.part.partname = PackURI("/ppt/slides/slide%d.xml" % i)


def move_slide_to_end(prs, index):
    id_list = prs.slides._sldIdLst
    entry = list(id_list)[index]
    id_list.remove(entry)
    id_list.append(entry)


def add_slide(prs, layout_index):
    return prs.slides.add_slide(prs.slide_masters[0].slide_layouts[layout_index])


def remove_placeholder(slide, idx):
    for shape in list(slide.placeholders):
        if shape.placeholder_format.idx == idx:
            shape._element.getparent().remove(shape._element)


def fit_title_size(text, base):
    """Chon co chu de tieu de vua mot dong trong be rong 11,2 inch."""
    return max(20, min(base, int(1380 / max(len(text), 1))))


def estimate_text_height(items, sizes, width_in=10.45):
    """Uoc chieu cao khoi gach dau dong, don vi inch."""
    total = 0.0
    for level, content in items:
        text = content.replace("**", "")
        size = sizes[min(level, len(sizes) - 1)]
        usable = width_in - 0.45 * level
        chars_per_line = max(20, int(usable * 72 / (size * 0.535)))
        lines = max(1, -(-len(text) // chars_per_line))
        total += lines * size * 1.42 / 72 + 0.10
    return total


def set_title(slide, text, size=30):
    size = fit_title_size(text, size)
    ph = slide.placeholders[0]
    left, top, width, height = TITLE_BOX
    ph.left, ph.top, ph.width, ph.height = left, top, width, height
    tf = ph.text_frame
    tf.word_wrap = True
    p = tf.paragraphs[0]
    p.text = text
    for run in p.runs:
        run.font.size = Pt(size)
        run.font.bold = True
        run.font.color.rgb = NAVY
        run.font.name = "Arial"


def fill_bullets(text_frame, items, sizes=(19, 16, 14)):
    """items: danh sach (level, noi_dung). Noi dung dung '**' de in dam."""
    text_frame.word_wrap = True
    first = True
    for level, content in items:
        p = text_frame.paragraphs[0] if first else text_frame.add_paragraph()
        first = False
        p.level = level
        p.alignment = PP_ALIGN.LEFT
        p.space_after = Pt(6)
        for chunk_index, chunk in enumerate(content.split("**")):
            if not chunk:
                continue
            run = p.add_run()
            run.text = chunk
            run.font.size = Pt(sizes[min(level, len(sizes) - 1)])
            run.font.name = "Arial"
            bold = chunk_index % 2 == 1
            run.font.bold = bold
            run.font.color.rgb = BLUE if bold else INK


def text_slide(prs, title, items, title_size=30, sizes=(19, 16, 14)):
    slide = add_slide(prs, L_OBJECT)
    set_title(slide, title, title_size)
    body = slide.placeholders[1]
    body.left, body.top, body.width, body.height = BODY_BOX
    fill_bullets(body.text_frame, items, sizes)
    return slide


def add_caption(slide, text, left, top, width):
    box = slide.shapes.add_textbox(left, top, width, Inches(0.3))
    tf = box.text_frame
    tf.word_wrap = True
    p = tf.paragraphs[0]
    p.alignment = PP_ALIGN.CENTER
    run = p.add_run()
    run.text = text
    run.font.size = Pt(12)
    run.font.italic = True
    run.font.name = "Arial"
    run.font.color.rgb = INK


def place_image(slide, filename, left, top, max_w, max_h):
    """Dat anh vao khung, giu ty le, can giua khung."""
    with Image.open(FIG / filename) as im:
        ratio = im.size[0] / im.size[1]
    width = max_w
    height = int(width / ratio)
    if height > max_h:
        height = max_h
        width = int(height * ratio)
    x = left + int((max_w - width) / 2)
    y = top + int((max_h - height) / 2)
    return slide.shapes.add_picture(str(FIG / filename), x, y, width, height)


def image_text_slide(prs, title, items, figure, caption, text_height=None,
                     title_size=30, sizes=(16, 14, 13)):
    """Slide tieu de tren, gach dau dong giua, anh ngang ben duoi."""
    slide = add_slide(prs, L_OBJECT)
    set_title(slide, title, title_size)
    if text_height is None:
        text_height = estimate_text_height(items, sizes) + 0.40
    body = slide.placeholders[1]
    body.left, body.top, body.width = Inches(0.85), Inches(1.28), Inches(11.57)
    body.height = Inches(text_height)
    fill_bullets(body.text_frame, items, sizes)

    img_top = Inches(1.28 + text_height + 0.08)
    img_h = Inches(7.5 - 0.62) - img_top - Inches(0.34)
    pic = place_image(slide, figure, Inches(0.85), img_top, Inches(11.57), img_h)
    add_caption(slide, caption, Inches(0.85), pic.top + pic.height + Inches(0.04),
                Inches(11.57))
    return slide


def side_image_slide(prs, title, items, figure, caption, title_size=28,
                     sizes=(17, 14, 13)):
    """Slide tieu de va chu ben trai, anh doc ben phai."""
    slide = add_slide(prs, L_OBJECT)
    set_title(slide, title, title_size)
    slide.placeholders[0].width = Inches(6.4)
    body = slide.placeholders[1]
    body.left, body.top, body.width, body.height = (
        Inches(0.85), Inches(1.45), Inches(6.2), Inches(5.3))
    fill_bullets(body.text_frame, items, sizes)

    pic = place_image(slide, figure, Inches(7.4), Inches(0.5),
                      Inches(5.0), Inches(6.0))
    add_caption(slide, caption, Inches(7.2), pic.top + pic.height + Inches(0.06),
                Inches(5.4))
    return slide


def table_slide(prs, title, headers, rows, col_widths, note=None,
                title_size=30, font_size=13, header_size=13, top=1.35):
    slide = add_slide(prs, L_OBJECT)
    set_title(slide, title, title_size)
    remove_placeholder(slide, 1)

    total = sum(col_widths)
    table_width = Inches(11.57)
    n_rows, n_cols = len(rows) + 1, len(headers)
    avail_h = Inches(6.55) - Inches(top) - (Inches(0.55) if note else Inches(0))
    row_h = int(avail_h / n_rows)
    shape = slide.shapes.add_table(n_rows, n_cols, Inches(0.85), Inches(top),
                                   table_width, int(avail_h))
    table = shape.table
    for i, w in enumerate(col_widths):
        table.columns[i].width = Emu(int(table_width * w / total))
    for row in table.rows:
        row.height = row_h

    def write(cell, text, bold, color, fill, size, align):
        cell.fill.solid()
        cell.fill.fore_color.rgb = fill
        cell.margin_left = Inches(0.06)
        cell.margin_right = Inches(0.06)
        cell.margin_top = Inches(0.02)
        cell.margin_bottom = Inches(0.02)
        cell.vertical_anchor = MSO_ANCHOR.MIDDLE
        tf = cell.text_frame
        tf.word_wrap = True
        p = tf.paragraphs[0]
        p.alignment = align
        run = p.add_run()
        run.text = text
        run.font.size = Pt(size)
        run.font.bold = bold
        run.font.name = "Arial"
        run.font.color.rgb = color

    for j, head in enumerate(headers):
        write(table.cell(0, j), head, True, WHITE, NAVY, header_size,
              PP_ALIGN.CENTER)
    # Cot nao co o dai qua 16 ky tu thi can trai toan cot, con lai can giua
    col_align = []
    for j in range(n_cols):
        longest = max(len(row[j].replace("**", "")) for row in rows)
        col_align.append(PP_ALIGN.LEFT if longest > 16 else PP_ALIGN.CENTER)
    for i, row in enumerate(rows):
        fill = WHITE if i % 2 == 0 else ROW_ALT
        for j, value in enumerate(row):
            bold = value.startswith("**")
            write(table.cell(i + 1, j), value.replace("**", ""), bold,
                  BLUE if bold else INK, fill, font_size, col_align[j])

    if note:
        box = slide.shapes.add_textbox(Inches(0.85), Inches(6.62),
                                       Inches(11.57), Inches(0.5))
        tf = box.text_frame
        tf.word_wrap = True
        p = tf.paragraphs[0]
        for index, chunk in enumerate(note.split("**")):
            if not chunk:
                continue
            run = p.add_run()
            run.text = chunk
            run.font.size = Pt(13)
            run.font.name = "Arial"
            run.font.bold = index % 2 == 1
            run.font.color.rgb = BLUE if index % 2 == 1 else INK
    return slide


